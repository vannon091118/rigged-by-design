{
  "schema": "narrative-pool/v1",
  "poolId": "casino.gaming.v1",
  "domain": "casino",
  "version": "1.0.0",
  "description": "Casino Narrative-Pool — domänenneutral, keine Spielsucht-Annahmen",
  "narratives": [
    {
      "id": "casino.welcome.001",
      "title": "Casino-Begrüßung",
      "description": "Ein Gast wird im Casino begrüßt",
      "domain": "casino",
      "version": "1.0.0",
      "conditions": [
        { "type": "actor-state", "targetActorId": "${target}", "operator": "eq", "targetValue": "guest", "description": "Ziel ist Gast im Casino" },
        { "type": "world-time", "operator": "gte", "targetValue": 0, "description": "Weltzeit ist gestartet" }
      ],
      "consequences": [
        { "type": "relationship-change", "targetActorId": "${target}", "dimension": "sympathy", "delta": 3, "description": "Sympathie leicht erhöht" }
      ],
      "weight": 5000,
      "cooldownTicks": 120,
      "maxExecutions": null,
      "executionCount": 0,
      "tags": ["welcome", "casino", "entry"]
    },
    {
      "id": "casino.win.reaction.001",
      "title": "Gewinn-Reaktion",
      "description": "Ein NPC reagiert auf einen Gewinn im Casino",
      "domain": "casino",
      "version": "1.0.0",
      "conditions": [
        { "type": "flag", "targetActorId": "${target}", "operator": "eq", "targetValue": "casino_win", "description": "Gewinn im Casino erzielt" },
        { "type": "relationship", "targetActorId": "${target}", "dimension": "rapport", "operator": "gte", "targetValue": 10, "description": "Basis-Rapport vorhanden" }
      ],
      "consequences": [
        { "type": "relationship-change", "targetActorId": "${target}", "dimension": "sympathy", "delta": 8, "description": "Sympathie durch gemeinsamen Gewinn erhöht" }
      ],
      "weight": 3000,
      "cooldownTicks": 180,
      "maxExecutions": 10,
      "executionCount": 0,
      "tags": ["win", "casino", "reaction"]
    },
    {
      "id": "casino.loss.consolation.001",
      "title": "Verlust-Trost",
      "description": "Ein NPC tröstet nach einem Casino-Verlust",
      "domain": "casino",
      "version": "1.0.0",
      "conditions": [
        { "type": "flag", "targetActorId": "${target}", "operator": "eq", "targetValue": "casino_loss", "description": "Verlust im Casino erlitten" },
        { "type": "relationship", "targetActorId": "${target}", "dimension": "sympathy", "operator": "gte", "targetValue": 25, "description": "Ausreichende Sympathie" }
      ],
      "consequences": [
        { "type": "relationship-change", "targetActorId": "${target}", "dimension": "sympathy", "delta": 5, "description": "Sympathie durch Trost erhöht" }
      ],
      "weight": 2500,
      "cooldownTicks": 240,
      "maxExecutions": 5,
      "executionCount": 0,
      "tags": ["loss", "consolation", "casino"]
    }
  ],
  "triggerConditions": {
    "maxNewEventsPerTick": 3,
    "maxPendingEvents": 48,
    "maxCandidates": 64
  },
  "repeatAndEscalation": {
    "maxRepetitionsPerDay": 5,
    "escalationCooldownTicks": 300,
    "stormPrevention": true
  },
  "timeWindows": {
    "binding": "WorldTime",
    "calendarDerived": true
  }
}