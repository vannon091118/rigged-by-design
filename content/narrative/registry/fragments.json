      "flags": [
        "narrativ",
        "startpool",
        "eroeffnung",
        "rita-kern"
      ],
      "text": "Rita Kern steht schon vor der Tür, als das Licht angeht. Sie kennt den Geruch von kaltem Neon und weiß, dass der erste Automat heute ihr gehört.",
      "directives": [],
      "source": "content/narrative/contributions/2026-11-01-startpool-01.json"
    },
    {
      "contributionId": "till-watch-01",
      "turnId": "2026-11-02T11:08Z-deckung-wut",
      "agentId": "codebuff",
      "role": "BEOBACHTER",
      "locale": "de",
      "slot": "reaction",
