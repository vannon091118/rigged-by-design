    {
      "contributionId": "b4-turnier-body-01",
      "turnId": "2026-11-04T06:20Z-b4-turnier-body",
      "agentId": "buffy",
      "role": "BEOBACHTER",
      "locale": "de",
      "slot": "event-body",
