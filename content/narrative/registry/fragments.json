      "personaRefs": [
        "rita-kern"
      ],
      "flags": [
        "narrativ",
        "rita-kern"
      ],
      "text": "Rita sah zur Neonreklame hinauf. Der Abend stand noch im Kalender, auch wenn das alte Buch ein neues Fach bekommen hatte.",
      "directives": [],
      "source": "content/narrative/contributions/2026-11-02-nachfragezustand.json"
    },
    {
      "contributionId": "opening-inheritance-01",
      "turnId": "2026-11-01T23:10Z-readme-onboarding",
      "agentId": "codex",
      "role": "ERZAEHLER",
