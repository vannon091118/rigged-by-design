      ],
      "flags": [
        "narrativ",
        "rueckkehrer"
      ],
      "text": "Rita blieb vor dem Automaten stehen. Sie erinnerte sich noch an den letzten Abend; heute war immerhin jemand da, der zuhoerte.",
      "directives": [],
      "source": "content/narrative/contributions/2026-11-02-trigger-bedingungen.json"
    },
    {
      "contributionId": "runtime-composer-01",
      "turnId": "2026-11-03T02:30Z-nar-11-runtime-composer",
