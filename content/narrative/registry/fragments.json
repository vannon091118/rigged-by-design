      "relationship": "neutral",
      "personaRefs": [
        "rita-kern"
      ],
      "flags": [
        "narrativ",
        "eroeffnung"
      ],
      "text": "Im Ordner des Nachlasses lag ein Kassenbon, der länger war als die Inventarliste. Rita nannte das keinen Schatz. Sie nannte es einen Anfang und fragte, ob der Gratis-Automat wenigstens selbst laufen könne.",
      "directives": [],
      "source": "content/narrative/contributions/2026-11-01-readme-opening.json"
    },
    {
      "contributionId": "patience-gap-01",
      "turnId": "2026-11-02T11:26Z-synergie-audit",
