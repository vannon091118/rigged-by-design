      "tone": "sachlich",
      "mood": "entschlossen",
      "relationship": "neutral",
      "personaRefs": [],
      "flags": [
        "narrativ"
      ],
      "text": "Hinter dem Tresen werden die Stimmen lauter, als hätte jemand die Regeln verlesen. Das Haus hat mehr Durst als Hände, und der Abend fragt nicht, ob das passt.",
      "directives": [],
      "source": "content/narrative/contributions/2026-11-04-b4-turnier-body.json"
