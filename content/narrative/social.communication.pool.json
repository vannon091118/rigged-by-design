{
  "schema": "narrative-pool/v1",
  "poolId": "social.communication.v1",
  "domain": "social",
  "version": "1.0.0",
  "description": "Social/Communication Narrative-Pool — domänenneutral, keine Casino-Annahmen",
  "narratives": [
    {
      "id": "social.greeting.001",
      "title": "Begrüßung",
      "description": "Ein NPC begrüßt den Spieler oder einen anderen NPC",
      "domain": "social",
      "version": "1.0.0",
      "conditions": [
        { "type": "actor-state", "targetActorId": "${target}", "operator": "eq", "targetValue": "present", "description": "Ziel ist anwesend" },
        { "type": "relationship", "targetActorId": "${target}", "dimension": "sympathy", "operator": "gte", "targetValue": 0, "description": "Sympathie nicht negativ" }
      ],
      "consequences": [
        { "type": "relationship-change", "targetActorId": "${target}", "dimension": "sympathy", "delta": 5, "description": "Sympathie leicht erhöht" }
      ],
      "weight": 3000,
      "cooldownTicks": 60,
      "maxExecutions": null,
      "executionCount": 0,
      "tags": ["greeting", "social", "icebreaker"]
    },
    {
      "id": "social.missed.call.001",
      "title": "Verpasster Anruf",
      "description": "Ein NPC erinnert sich an einen verpassten Anruf und folgt nach",
      "domain": "social",
      "version": "1.0.0",
      "conditions": [
        { "type": "flag", "targetActorId": "${target}", "operator": "eq", "targetValue": "missed_call", "description": "Es gab einen verpassten Anruf" },
        { "type": "relationship", "targetActorId": "${target}", "dimension": "trust", "operator": "gte", "targetValue": 20, "description": "Ausreichendes Vertrauen" }
      ],
      "consequences": [
        { "type": "relationship-change", "targetActorId": "${target}", "dimension": "trust", "delta": -5, "description": "Vertrauen leicht gesunken" },
        { "type": "event-emit", "eventType": "comm.callback.requested", "eventPayload": { "callbackTo": "${target}" }, "description": "Rückruf wird angefragt" }
      ],
      "weight": 2000,
      "cooldownTicks": 300,
      "maxExecutions": 3,
      "executionCount": 0,
      "tags": ["missed_call", "followup", "communication"]
    },
    {
      "id": "social.promise.kept.001",
      "title": "Eingehaltenes Versprechen",
      "description": "Ein NPC hat ein Versprechen eingehalten und stärkt die Beziehung",
      "domain": "social",
      "version": "1.0.0",
      "conditions": [
        { "type": "flag", "targetActorId": "${target}", "operator": "eq", "targetValue": "promise_kept", "description": "Versprechen wurde eingehalten" },
        { "type": "relationship", "targetActorId": "${target}", "dimension": "trust", "operator": "gte", "targetValue": 10, "description": "Basisvertrauen vorhanden" }
      ],
      "consequences": [
        { "type": "relationship-change", "targetActorId": "${target}", "dimension": "trust", "delta": 15, "description": "Vertrauen gestärkt" },
        { "type": "relationship-change", "targetActorId": "${target}", "dimension": "rapport", "delta": 10, "description": "Rapport verbessert" }
      ],
      "weight": 4000,
      "cooldownTicks": 600,
      "maxExecutions": 5,
      "executionCount": 0,
      "tags": ["promise", "trust", "followthrough"]
    },
    {
      "id": "social.repeated.contact.001",
      "title": "Wiederholte Kontaktmuster",
      "description": "Ein NPC bemerkt wiederholte Kontakte und passt sein Verhalten an",
      "domain": "social",
      "version": "1.0.0",
      "conditions": [
        { "type": "actor-state", "targetActorId": "${target}", "operator": "gte", "targetValue": 5, "description": "Mindestens 5 Kontakte" },
        { "type": "relationship", "targetActorId": "${target}", "dimension": "rapport", "operator": "gte", "targetValue": 30, "description": "Guter Rapport" }
      ],
      "consequences": [
        { "type": "relationship-change", "targetActorId": "${target}", "dimension": "rapport", "delta": 5, "description": "Rapport durch Vertrautheit erhöht" }
      ],
      "weight": 2500,
      "cooldownTicks": 900,
      "maxExecutions": 10,
      "executionCount": 0,
      "tags": ["repeated_contact", "familiarity", "habit"]
    }
  ],
  "triggerConditions": {
    "maxNewEventsPerTick": 3,
    "maxPendingEvents": 48,
    "maxCandidates": 64
  },
  "repeatAndEscalation": {
    "maxRepetitionsPerDay": 5,
    "escalationCooldownTicks": 300,
    "stormPrevention": true
  },
  "timeWindows": {
    "binding": "WorldTime",
    "calendarDerived": true
  }
}