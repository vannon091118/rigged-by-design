{
  "name": "rigged-by-design",
  "private": true,
  "version": "0.3.30",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:perf": "vitest bench --run",
    "soak": "RBD_SOAK_TICKS=100000 vitest run src/core/sim/__tests__/soak.test.ts",
    "bench:lowend": "node scripts/bench-lowend.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:loc": "node scripts/check-loc.mjs",
    "verify:all": "node scripts/run-pipeline.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit:gate": "npm audit --audit-level=low",
    "verify:test-quality": "node scripts/verify-test-quality.mjs",
    "verify:dead-code": "node scripts/verify-dead-code.mjs",
    "verify:commit-msg": "node scripts/verify-commit-msg.mjs --head",
    "sync:deps": "node scripts/sync-dependency-matrix.mjs",
    "autofix:0911": "node scripts/autofix-0911.mjs",
    "android:apk": "node scripts/prepare-android.mjs",
    "turn:finish": "node scripts/turn-push.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.6.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.7",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
