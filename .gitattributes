# Zeilenenden: der Generator schreibt LF. Mit core.autocrlf=true erzeugt Git
# beim Checkout sonst CRLF, der Arbeitsbaum gilt danach als geaendert und der
# Inhalts-Hash des Gate-Caches passt nicht mehr. Nur generierte Dateien regeln,
# keine globale Renormalisierung.
docs/ARCHITECTURE.md text eol=lf

# Binaerdateien nie umkodieren.
*.png binary
*.apk binary

# Generierte Artefakte werden bei einem Konflikt nicht verhandelt, sondern aus
# den Quellen neu erzeugt (#877). Der Driver ist repo-lokal registriert
# (`pnpm run hooks:install`); fehlt er, bleibt es beim normalen Konflikt.
.lane-claims/merged-index.json merge=generated-regenerate
docs/INVENTORY.md merge=generated-regenerate
docs/ROADMAP.md merge=generated-regenerate
content/narrative/registry/fragments.json merge=generated-regenerate
src/core/sim/narrative/composer/registry.generated.ts merge=generated-regenerate
src/core/sim/narrative/composer/slot-map.generated.ts merge=generated-regenerate
