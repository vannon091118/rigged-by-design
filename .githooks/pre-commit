#!/bin/sh
# Pflege vor jedem Commit. Verify-Gates bleiben lesend; hier wird geschrieben,
# weil der Hook den Commit vorbereitet. Fehlt node_modules, laufen nur Matrix
# und Testkatalog nicht, weil sie typescript aus node_modules laden.
set -e
# Lane-Claims durchsetzen: der aktuelle Branch muss einen Claim haben und
# darf nur Dateien innerhalb seiner Allowlist schreiben. Kollisionen mit
# anderen offenen Lanes blockieren den Commit. Das Skript liest nur Git und
# laeuft deshalb auch ohne node_modules; nur so greift die Sperre wirklich.
node scripts/verify-lane-claims.mjs || exit 1
# Der Task-Vertrag ist die Wahrheit des Laufs: Claim-Bindung, Pflichtfelder
# und Phasenwechsel werden vor dem Commit geprueft. Ohne Vertrag bleibt eine
# Legacy-Lane gruen; mit Vertrag ist ein ungueltiger Wechsel rot.
node scripts/verify-task-contract.mjs --staged || exit 1
# Fail-closed: Der Validator liest den Arbeitsbaum. Weicht eine gestagte
# Narrative-Datei dort noch ab, wuerde ein anderer Inhalt geprueft als der
# Commit. Dann blockiert der Hook, statt den Widerspruch zu uebersehen.
git diff --cached --name-only -- content/narrative | while IFS= read -r path; do
  [ -n "$path" ] || continue
  if ! git diff --quiet -- "$path"; then
    echo "pre-commit: $path ist gestaged, aber im Arbeitsbaum noch veraendert (ERR-4022) - Commit blockiert; erst stagen oder Aenderung verwerfen" >&2
    exit 1
  fi
done
# Der Content-Validator braucht keine node_modules und laeuft deshalb vor dem
# Fruehausstieg. Er prueft Schema, Vokabular, Manifest und Registry-Bytes.
if ! node scripts/verify-narrative-content.mjs; then
  echo "pre-commit: Narrative-Content ungueltig (ERR-4022) - Commit blockiert" >&2
  exit 1
fi
# Pflicht pro Commit: mindestens ein neuer Textbaustein, im Manifest
# registriert und in der Registry verdrahtet, und nur in einem Pool, der die
# Mindestgroesse noch nicht erreicht hat. Content ohne Verdrahtung blockiert.
if ! node scripts/verify-narrative-blocks.mjs --commit; then
  echo "pre-commit: Textbaustein-Pflicht verletzt (ERR-4022) - Commit blockiert" >&2
  exit 1
fi
# Inventur, Doku-Marker, Doku-Gate und LOC lesen nur Dateien und Git; sie
# brauchen keine node_modules. Deshalb laufen sie auch im Fruehausstieg, damit
# ein frischer Klon nicht ungeprueft committet.
inventory_docs_loc() {
  # Ein Regenerationspfad fuer Inventur, Marker, Registry und Fortschritt:
  # jede Datei kommt aus ihrem Generator und wird nur dort gestaged. Damit
  # traegt kein Feature-Commit mehr handgeschriebene Generator-Artefakte.
  if ! node scripts/sync-generated.mjs --staged; then
    echo "pre-commit: generierte Artefakte nicht aktuell (ERR-4017) - Commit blockiert, node scripts/sync-generated.mjs ausfuehren" >&2
    exit 1
  fi
  node scripts/verify-docs.mjs
  if ! node scripts/check-loc.mjs >/tmp/rbd-loc.log 2>&1; then
    tail -20 /tmp/rbd-loc.log
    echo "pre-commit: LOC-Cap verletzt (Eskalation AGENT: Datei splitten)"
    exit 1
  fi
}
if [ ! -d node_modules ]; then
  inventory_docs_loc
  echo "pre-commit: node_modules fehlt - Matrix und Katalog uebersprungen (pnpm install --frozen-lockfile)"
  exit 0
fi
# Ein verschluckter Generatorfehler hinterlaesst ein veraltetes Artefakt, das
# danach niemand mehr als veraltet erkennt. Deshalb blockiert er den Commit.
if ! node scripts/sync-dependency-matrix.mjs >/dev/null 2>&1; then
  echo "pre-commit: Dependency-Matrix nicht aktualisiert (ERR-0911) - Commit blockiert, pnpm run fix ausfuehren" >&2
  exit 1
fi
if ! node scripts/test-catalog.mjs >/dev/null 2>&1; then
  echo "pre-commit: Testkatalog nicht aktualisiert (ERR-0911) - Commit blockiert, pnpm run fix ausfuehren" >&2
  exit 1
fi
inventory_docs_loc
# Governance-Freeze zuletzt: die Generatoren oben schreiben Doku, Matrix und
# Inventur neu und koennen dabei Steuerdateien anfassen. Prueft das Gate davor,
# sieht es einen anderen Staging-Stand als den Commit - lokal gruen, in CI rot.
# Deshalb laeuft es als letzter Schritt, nach jedem Generator und jedem Stagen.
if ! node scripts/verify-governance-freeze.mjs; then
  echo "pre-commit: Governance-Freeze verletzt (ERR-4030) - Commit blockiert" >&2
  exit 1
fi
echo "pre-commit: Doku, Matrix, LOC und Freeze geprueft"
